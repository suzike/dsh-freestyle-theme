{
  "name": "dsh-freestyle-theme",
  "version": "0.6.5",
  "description": "FreeStyle 主题：全窗口主题工作室，实时设计、对比预览、色觉模拟、无障碍体检、12 套坐标预设、主题库、图片/一句话生成与分享码，覆盖全部 119 个 --dsw- 令牌并自适应明暗。",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepack": "pnpm build",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "figures": "node scripts/gen-figures.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.5",
    "lightningcss": "1.32.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause"
}
